$TTL 300
@       IN SOA  ns1.example.com. admin.example.com. (
            2026071705 ; serial
            3600
            1800
            604800
            300
        )

; NS records below are required for named-checkzone (make validate-zones)
; but must NOT reach the live Forwarder zone in Technitium: a zone
; delegated to itself via local NS records makes Technitium attempt real
; self-referential recursive resolution instead of using the FWD record
; for any name not explicitly listed in this file -- confirmed live
; 2026-07-17 (see AI.md). The deploy pipeline (push-zones.sh and
; configure-technitium.yaml) deletes these NS records from the live zone
; immediately after every import, same pattern as re-adding FWD.
            IN NS   ns1.example.com.
            IN NS   ns2.example.com.
ns1         IN A    192.0.2.1
ns2         IN A    192.0.2.2

; --- Internal LoadBalancer Services (manual records) ---
; Add one A record per internal host/service you want Technitium to
; answer authoritatively for, e.g.:
example-host    IN A    192.0.2.10

externaldns     IN TXT  "managed"
