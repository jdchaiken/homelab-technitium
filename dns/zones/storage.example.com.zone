$TTL 300
@       IN SOA  ns1.storage.example.com. admin.storage.example.com. (
            2026071602 ; serial
            3600       ; refresh
            1800       ; retry
            604800     ; expire
            300        ; minimum
        )

        IN NS   ns1.storage.example.com.
        IN NS   ns2.storage.example.com.
ns1     IN A    172.16.100.6
ns2     IN A    172.16.100.8

; --- Bare-metal & Storage Infrastructure ---
pbs     IN A    172.16.70.2
pve01   IN A    172.16.70.204
pve02   IN A    172.16.70.201
pve03   IN A    172.16.70.203
pve04   IN A    172.16.70.205
nas01   IN A    172.16.70.241
nas02   IN A    172.16.70.243

; --- TXT registry for ExternalDNS coexistence ---
externaldns IN TXT  "managed"
