$TTL 300
@       IN SOA  ns1.example.com. admin.example.com. (
            2026071701 ; serial
            3600
            1800
            604800
            300
        )

            IN NS   ns1.example.com.
            IN NS   ns2.example.com.
ns1         IN A    172.16.100.6
ns2         IN A    172.16.100.8

; --- Internal LoadBalancer Services (manual records) ---
ldap        IN A    10.30.0.3
git         IN A    10.30.0.4
alloy       IN A    10.30.0.10
files       IN A    172.16.100.241
pve01       IN A    172.16.100.204
pve02       IN A    172.16.100.201
pve03       IN A    172.16.100.203
pve04       IN A    172.16.100.205
; docker02 stays manual: currently stopped with no static IP configured,
; so proxmox-dns-sync.sh can't determine its address (confirmed -- it
; never appears in the sync's discovered list). Give it a static
; ipconfig or leave it running with the guest agent for the sync to
; pick it up, then remove this line.
docker02    IN A    172.16.0.104
ups01       IN A    172.16.0.100
idrac-pve02 IN A    172.16.0.146
ratgdo      IN A    172.16.107.195
sump-alarm  IN A    172.16.107.249
pbs-remote  IN A    192.168.20.3

externaldns     IN TXT  "managed"
