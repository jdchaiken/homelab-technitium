$TTL 300
@       IN SOA  ns1.example.net. admin.example.net. (
            2026071705 ; serial
            3600
            1800
            604800
            300
        )

; NS records below are required for named-checkzone but deleted from the
; live zone by the deploy pipeline -- see example.com.zone for why.
        IN NS   ns1.example.net.
        IN NS   ns2.example.net.
ns1     IN A    192.0.2.1
ns2     IN A    192.0.2.2

; --- Internal LoadBalancer Services ---
; Add one A record per internal host/service, e.g.:
example-host    IN A    192.0.2.10

; --- TXT registry for ExternalDNS ---
externaldns     IN TXT  "managed"
