$TTL 300
@       IN SOA  ns1.storage.example.com. admin.storage.example.com. (
            2026071705 ; serial
            3600       ; refresh
            1800       ; retry
            604800     ; expire
            300        ; minimum
        )

; NS records below are required for named-checkzone but deleted from the
; live zone by the deploy pipeline -- see example.com.zone for why.
        IN NS   ns1.storage.example.com.
        IN NS   ns2.storage.example.com.
ns1     IN A    192.0.2.1
ns2     IN A    192.0.2.2

; --- Bare-metal & Storage Infrastructure ---
; Add one A record per host, e.g.:
example-host    IN A    192.0.2.10

; --- TXT registry for ExternalDNS coexistence ---
externaldns IN TXT  "managed"
