# Sample Bitwarden environment file
# Copy this file to bw.env and fill in your real credentials.
# DO NOT commit bw.env to Git.

# The REAL FILE SHOULD BE PLACED in
# /etc/pve/technitium/bw.env

BW_TOKEN="your-bitwarden-service-account-token"
BW_ORGID="your-organization-id"
BW_PROJECTID="your-project-id"
TECHNITIUM_ADMIN_PASSWORD="your-new-technitium-admin-password"

# Only needed if you enable the matching app/feature in
# technitium/ansible/configure-technitium-apps.yaml (commented out by
# default -- see that file for how to turn one on).
# TECHNITIUM_QUERYLOGS_PG_PASSWORD="your-postgres-password"
# TECHNITIUM_FAILOVER_SMTP_PASSWORD="your-smtp-alert-password"
# TECHNITIUM_LOGEXPORTER_HTTP_TOKEN="your-log-sink-bearer-token"

# SSO: one JSON secret, NOT quoted (unlike the keys above) -- quoting it
# would require escaping the double quotes JSON itself needs. Must be a
# single line.
# TECHNITIUM_SSO_CONFIG={"authority":"https://sso.example.com/app/o/technitium/","clientId":"your-client-id","clientSecret":"your-client-secret","groupMap":"idp-admins|Administrators"}