# Sample Bitwarden environment file
# Copy this file to bw.env and fill in your real credentials.
# DO NOT commit bw.env to Git.

# The REAL FILE SHOULD BE PLACED in
# /etc/pve/technitium/bw.env

BW_TOKEN="your-bitwarden-service-account-token"
BW_ORGID="your-organization-id"
BW_PROJECTID="your-project-id"
TECHNITIUM_ADMIN_PASSWORD="your-new-technitium-admin-password"

# Required -- used by configure-technitium-tls.yaml (runs on every deploy)
# to issue the Let's Encrypt cert for DoT/DoH/DoH3/DoQ via Cloudflare DNS-01.
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token-scoped-to-dns-edit"

# Required -- ACME registration contact for the Let's Encrypt cert above.
# Use a role address (e.g. dns-admin@yourdomain.com), not a personal one --
# this is only for Let's Encrypt's own expiry/revocation notices.
ACME_EMAIL="your-acme-contact-email"

# Only needed if you enable the matching app/feature in
# technitium/ansible/configure-technitium-apps.yaml (commented out by
# default -- see that file for how to turn one on).
# TECHNITIUM_FAILOVER_SMTP_PASSWORD="your-smtp-alert-password"
# TECHNITIUM_LOGEXPORTER_HTTP_TOKEN="your-log-sink-bearer-token"

# Query Logs (PostgreSQL): one JSON secret, NOT quoted, same reasoning as
# SSO below -- the whole connection config (server/username/password/port/
# databaseName) stays out of this file and out of bw.env as loose fragments.
# TECHNITIUM_QUERYLOGS_PG_CONFIG={"server":"your-postgres-host-or-ip","username":"technitium","password":"your-postgres-password","port":5432,"databaseName":"DnsQueryLogs"}

# SSO: one JSON secret, NOT quoted (unlike the keys above) -- quoting it
# would require escaping the double quotes JSON itself needs. Must be a
# single line.
# TECHNITIUM_SSO_CONFIG={"authority":"https://sso.example.com/app/o/technitium/","clientId":"your-client-id","clientSecret":"your-client-secret","groupMap":"idp-admins|Administrators"}

# OPNsense TSIG sync: one JSON secret, NOT quoted, same reasoning as SSO
# above. apiKey/apiSecret are generated under OPNsense's own
# System > Access > Users > (user) > API Keys page (HTTP Basic auth --
# apiKey is the username, apiSecret is the password). host must include
# the scheme (https://...), no trailing slash.
OPNSENSE_API_CONFIG={"host":"https://opnsense.example.com","apiKey":"your-api-key","apiSecret":"your-api-secret"}