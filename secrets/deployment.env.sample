# Sample consolidated deployment config.
#
# Copy this file to secrets/deployment.env and fill in your real values,
# then run `make generate-config` (scripts/generate-config.sh) to write:
#   - secrets/bw.env
#   - technitium/terraform/local/terraform.tfvars
#   - technitium/terraform/local/staging.tfvars
#   - technitium/cloud-init/local/technitium-user.yaml
#   - technitium/cloud-init/local/technitium-user-ns2.yaml
#
# This is the ONE file to edit going forward for anything that used to mean
# hand-editing one of those five files directly. secrets/deployment.env
# itself is gitignored -- DO NOT commit it.
#
# NOTE: this does not (yet) cover technitium/ansible/configure-technitium-
# apps.yaml's optional DNS Apps (still enabled/disabled by hand, commenting
# blocks in that file directly).

###############################################################################
# Bitwarden Secrets Manager
###############################################################################
BW_TOKEN="your-bitwarden-service-account-token"
BW_ORGID="your-organization-id"
BW_PROJECTID="your-project-id"

###############################################################################
# Technitium
###############################################################################
TECHNITIUM_ADMIN_PASSWORD="your-new-technitium-admin-password"

###############################################################################
# ACME / Let's Encrypt (via Cloudflare DNS-01)
###############################################################################
ACME_EMAIL="your-acme-contact-email"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token-scoped-to-dns-edit"

###############################################################################
# OPNsense (TSIG sync)
# apiKey/apiSecret from OPNsense's System > Access > Users > (user) > API
# Keys page. host must include the scheme, no trailing slash.
###############################################################################
OPNSENSE_HOST="https://opnsense.yourdomain.com"
OPNSENSE_API_KEY="your-opnsense-api-key"
OPNSENSE_API_SECRET="your-opnsense-api-secret"

###############################################################################
# Query Logs (PostgreSQL) -- only needed if that app is enabled in
# configure-technitium-apps.yaml.
###############################################################################
QUERYLOGS_PG_SERVER="your-postgres-host-or-ip"
QUERYLOGS_PG_USERNAME="technitium"
QUERYLOGS_PG_PASSWORD="your-postgres-password"
QUERYLOGS_PG_PORT="5432"
QUERYLOGS_PG_DATABASE="DnsQueryLogs"

###############################################################################
# SSO (OpenID Connect) -- only needed if enabled in
# configure-technitium-apps.yaml.
###############################################################################
SSO_AUTHORITY="https://sso.example.com/app/o/technitium/"
SSO_CLIENT_ID="your-client-id"
SSO_CLIENT_SECRET="your-client-secret"
SSO_GROUP_MAP="idp-admins|Administrators"

###############################################################################
# proxmox-dns-sync.sh overrides -- optional, both fall back to sensible
# defaults (ns1's prod IP, the base domain below) if left blank.
###############################################################################
PROXMOX_DNS_SYNC_TECHNITIUM_API=""
PROXMOX_DNS_SYNC_ZONE=""

###############################################################################
# Proxmox API
###############################################################################
PM_API_URL="https://pve01.yourdomain.com:8006/api2/json"
PM_USER="root@pam"
PM_PASSWORD="your-proxmox-root-password"
PM_NODE="pve02"
TARGET_NODE="pve02"
NS2_TARGET_NODE="pve04"
DATASTORE="itank"
CLOUD_INIT_IMAGE_ID="tank:9000/vm-9000-disk-0.raw"

###############################################################################
# Networking -- production
# MUST include the CIDR mask on the *_vm_ip values (Proxmox 9.2 cloud-init).
###############################################################################
GATEWAY_IP="172.16.100.1"
TEMP_VM_IP="172.16.100.7/24"
PROD_VM_IP="172.16.100.6/24"
NS2_TEMP_VM_IP="172.16.100.9/24"
NS2_PROD_VM_IP="172.16.100.8/24"

###############################################################################
# Networking -- staging (used only in staging.tfvars)
###############################################################################
STAGING_TEMP_VM_IP="172.16.100.11/24"
STAGING_PROD_VM_IP="172.16.100.10/24"
STAGING_NS2_TEMP_VM_IP="172.16.100.13/24"
STAGING_NS2_PROD_VM_IP="172.16.100.12/24"

###############################################################################
# VM credentials
###############################################################################
VM_PASSWORD="your-vm-root-password"
SSH_PUBKEY="ssh-ed25519 AAAA... you@yourhost"
# SSH_PRIVKEY="~/.ssh/id_ed25519"   # optional, defaults to ~/.ssh/id_ed25519

###############################################################################
# Rebuild triggers -- bump to force a rebuild + cutover. Independent of each
# other: bumping one never force-replaces the other.
###############################################################################
REBUILD_ID="1"
NS2_REBUILD_ID="1"

###############################################################################
# Staging-specific identity
###############################################################################
STAGING_DNS_HOSTNAME="ns1-staging.yourdomain.com"
STAGING_ACME_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"
STAGING_NFS_SUBDIR="technitium-staging"

###############################################################################
# DNS hostnames (production ns1/ns2) -- also used for cloud-init hostname/
# fqdn.
###############################################################################
BASE_DOMAIN="yourdomain.com"
NS1_HOSTNAME="ns1"
NS2_HOSTNAME="ns2"

###############################################################################
# VM timezone (cloud-init)
###############################################################################
TIMEZONE="America/New_York"
