# Production tfvars. For a throwaway pre-deploy test environment on the
# same cluster, see staging.tfvars.example instead.
pm_api_url  = "https://pve01:8006/api2/json"
pm_user     = "root@pam"
pm_password = "CHANGE_ME"

pm_node     = "pve01"
target_node = "pve01"
datastore   = "tank"

cloud_init_image_id = "tank:iso/debian-13-generic-amd64.qcow2"
# cloudinit_template = 9000                # optional, defaults to 9000

temp_vm_ip = "172.16.100.7/24"
prod_vm_ip = "172.16.100.6/24"
gateway_ip = "172.16.100.1"
# prod_vm_name = "technitium"              # optional, defaults to "technitium"

vm_password = "CHANGE_ME"
ssh_pubkey  = "ssh-ed25519 AAAA...yourkey"
# ssh_privkey = "~/.ssh/id_ed25519"        # optional, defaults to ~/.ssh/id_ed25519

# old_vm_id = 3000                         # optional override, defaults to null -- Terraform auto-detects the current production VMID; only set this to force a specific one
# rebuild_id = "1"                         # optional, defaults to "1" -- bump this to force a rebuild + cutover

###############################################################################
# ns2 (Secondary DNS Server) -- co-exists with ns1 in this same apply, not a
# separate workspace/tfvars. Must be on a different Proxmox node than
# target_node above for actual redundancy.
###############################################################################
ns2_target_node = "pve02"                # different node than target_node
ns2_temp_vm_ip  = "172.16.100.8/24"
ns2_prod_vm_ip  = "172.16.100.9/24"
# ns2_prod_vm_name = "ns2"                 # optional, defaults to "ns2"
# ns2_dns_hostname = "ns2.example.com"   # optional, defaults to "ns2.example.com"
# ns2_nfs_subdir = "technitium-ns2"        # optional, defaults to "technitium-ns2"
# ns2_old_vm_id = 3001                     # optional override, defaults to null -- auto-detected like old_vm_id
# ns2_rebuild_id = "1"                     # optional, defaults to "1" -- independent from rebuild_id, bump this to rebuild ns2 without touching ns1
